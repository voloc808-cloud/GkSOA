{
  "info": {
    "name": "Quản lý đồ án SOA",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order: login admin, CRUD and business rules, logout. Demo account credentials can be changed in collection variables."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": "Demo@12345"
    },
    {
      "key": "auth_token",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === 'Thống kê') { const stamp = Date.now(); pm.collectionVariables.set('student_code', 'PMSV' + stamp); pm.collectionVariables.set('topic_code', 'PMDT' + stamp); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Đăng nhập admin",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{username}}\",\"password\":\"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if(pm.response.code === 200) pm.collectionVariables.set('auth_token',pm.response.json().data.access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Thống kê",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/dashboard"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON envelope', () => pm.expect(pm.response.json().success).to.be.a('boolean'));"
            ]
          }
        }
      ]
    },
